From: Johnny Castaway contributors
Subject: Wii: support a GPLv3-only statically linked single-core frontend
SPDX-License-Identifier: GPL-3.0-or-later

RetroArch revision 96a1b1a9cf3f9166affcfd7df4323aa58d5c281a embeds
wii/app_booter when HAVE_RARCH_EXEC is enabled. That component is GPLv2-only,
so it cannot be included in this GPLv3 combined frontend. Disable the optional
legacy networking, achievements, threaded USB-HID, and re-exec paths; guard their
objects and callbacks; and expose a linked target identity for fail-closed artifact
validation.

The normal statically linked Johnny core, content browser, RGUI, GX video/audio,
Wiimote/Classic Controller/GameCube-pad input, configuration, and save-state paths
remain enabled. The build also sets HAVE_THREADS=0 and disables the legacy socket
define on the command line for compatibility with current devkitPPC/libogc.

diff --git a/Makefile.wii b/Makefile.wii
index 761ad03..954f1b3 100644
--- a/Makefile.wii
+++ b/Makefile.wii
@@ -7,8 +7,8 @@ HAVE_FILE_LOGGER           = 0
 HAVE_CC_RESAMPLER          = 1
 WHOLE_ARCHIVE_LINK         = 0
 BIG_STACK                  = 1
-HAVE_NETWORKING            = 1
-HAVE_IFINFO                = 1
+HAVE_NETWORKING            = 0
+HAVE_IFINFO                = 0
 PC_DEVELOPMENT_IP_ADDRESS  = 255.255.255.255
 PC_DEVELOPMENT_UDP_PORT    = 3490
 RARCH_CONSOLE              = 0
@@ -159,20 +159,24 @@ HAVE_STATIC_AUDIO_FILTERS := 1
 HAVE_STATIC_VIDEO_FILTERS := 1
 
 #HAVE_LANGEXTRA          := 1
-HAVE_WIIUSB_HID          := 1
-HAVE_HID                 := 1
-HAVE_RARCH_EXEC          := 1
+HAVE_WIIUSB_HID          := 0
+HAVE_HID                 := 0
+HAVE_RARCH_EXEC          := 0
 HAVE_RSOUND              := 0
 HAVE_XMB                 := 0
 HAVE_OZONE               := 0
 HAVE_RGUI                := 1
 HAVE_MATERIALUI          := 0
-HAVE_CHEEVOS             := 1
+HAVE_CHEEVOS             := 0
 
-CFLAGS      += -DHAVE_SOCKET_LEGACY -DHAVE_CHEEVOS
+CFLAGS      += -DHAVE_SOCKET_LEGACY
 
 APP_BOOTER_DIR = wii/app_booter
-PLATOBJS := $(APP_BOOTER_DIR)/app_booter.binobj
+PLATOBJS :=
+
+ifeq ($(HAVE_RARCH_EXEC), 1)
+   PLATOBJS += $(APP_BOOTER_DIR)/app_booter.binobj
+endif
 
 ifeq ($(USBGECKO), 1)
    CFLAGS += -DUSBGECKO
@@ -183,7 +187,15 @@ INCLUDE += -I./libretro-common/include \
 	   -Ideps/rcheevos/include
 CFLAGS += -Wall -std=gnu99 $(MACHDEP) $(PLATCFLAGS) $(INCLUDE)
 
-OBJ =  $(PLATOBJS) audio/drivers/gx_audio.o gfx/drivers/gx_gfx.o input/drivers/gx_input.o frontend/drivers/platform_gx.o input/drivers_joypad/gx_joypad.o libretro-common/memory/mem2_manager.o gfx/drivers/gx_gfx_vi_encoder.o frontend/drivers/platform_wii.o input/drivers_hid/wiiusb_hid.o
+OBJ =  $(PLATOBJS) audio/drivers/gx_audio.o gfx/drivers/gx_gfx.o input/drivers/gx_input.o frontend/drivers/platform_gx.o input/drivers_joypad/gx_joypad.o libretro-common/memory/mem2_manager.o gfx/drivers/gx_gfx_vi_encoder.o
+
+ifeq ($(HAVE_WIIUSB_HID), 1)
+   OBJ += input/drivers_hid/wiiusb_hid.o
+endif
+
+ifeq ($(HAVE_RARCH_EXEC), 1)
+   OBJ += frontend/drivers/platform_wii.o
+endif
 
 ifeq ($(EXTERNAL_LIBOGC), 0)
    OBJ += wii/libogc/libfat/libfat.o wii/libogc/libfat/fatfile.o wii/libogc/libfat/file_allocation_table.o wii/libogc/libfat/cache.o wii/libogc/libfat/fatdir.o wii/libogc/libfat/partition.o wii/libogc/libfat/directory.o wii/libogc/libfat/filetime.o wii/libogc/libfat/disc.o
@@ -307,16 +319,20 @@ $(EXT_INTER_TARGET): $(OBJ)
 %.binobj: %.bin
 	$(LD) -r -b binary $(OBJOUT)$@ $<
 
+ifeq ($(HAVE_RARCH_EXEC), 1)
 $(APP_BOOTER_DIR)/app_booter.bin:
 	export EXTERNAL_LIBOGC
 	$(MAKE) -C $(APP_BOOTER_DIR)
+endif
 
 clean:
 	@$(if $(Q), echo $@,)
 	$(Q)rm -f $(EXT_TARGET)
 	$(Q)rm -f $(EXT_INTER_TARGET)
 	$(Q)rm -f $(OBJ)
+ifeq ($(HAVE_RARCH_EXEC), 1)
 	$(Q)$(MAKE) -C $(APP_BOOTER_DIR) clean
+endif
 
 .PHONY: clean
 
